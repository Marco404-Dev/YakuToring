WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_API_VERSION=v25.0
# Vacío: detectar el idioma aprobado en Meta. Si se configura, se verifica igualmente.
WHATSAPP_TEMPLATE_LANGUAGE=
PORT=3001
STALE_SECONDS=30
# 1 permite estimar OD con EC provisional en mS/cm solo para ensayos experimentales.
YAKUTORING_OD_ALLOW_PROVISIONAL_EC=0
YAKUTORING_ACTIVE_MODELS=catboost
YAKUTORING_MONITOR_ENVIRONMENT=manglar
YAKUTORING_HOST=127.0.0.1
# Render usa agent, sin puertos locales. El agente usa una URL HTTPS directa al backend.
YAKUTORING_SERIAL_MODE=local
YAKUTORING_AGENT_URL=
YAKUTORING_INGEST_TOKEN=
YAKUTORING_FRONTEND_ORIGIN=
# Opcionales, solo para recibir estados de WhatsApp desde Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Unidad que realmente transmite el Sender. Normalización única antes del ML.
YAKUTORING_EC_INPUT_UNIT=uS/cm
# Usuarios administrativos en .local/users.json: npm run auth:setup
# No modificar este archivo para configurar Cloudflare; usar npm run remote.
